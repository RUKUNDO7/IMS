{
  "name": "cohort-management-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web --output-dir web-build",
    "build:android": "npx eas-cli build --platform android",
    "build:ios": "npx eas-cli build --platform ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3"
  }
}
